# Los secretos de proveedores externos nunca deben declararse con prefijo VITE_
# ni inyectarse en el navegador. Configúralos únicamente como secretos de una
# función de servidor cuando se habilite una integración empresarial.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Secretos de la Edge Function create-public-student-record (configurar con Supabase secrets).
# RATE_LIMIT_SALT="A_LONG_RANDOM_SECRET"
# PUBLIC_FORM_ORIGINS="https://your-domain.example"
